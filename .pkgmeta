package-as: MacroForge

enable-nolib-creation: no

# Written by the Release workflow from this version's CHANGES.md section
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - screenshots
  - docs
  - tools
  - tests
  - .github
  - .luacheckrc
  - CHANGES.md
  - RELEASE_NOTES.md
